# Variables de entorno para conectar con Supabase
# Copiar este archivo a .env.local para configurar tus credenciales reales
# NUNCA compartas claves de servicio o secretas (service_role) en el cliente

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anonima-publica-aqui
